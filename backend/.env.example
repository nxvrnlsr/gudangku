# =============================================
# GudangKu Backend - Environment Variables
# =============================================
# PENTING: Jangan pernah commit file ini ke GitHub!

# Server
PORT=3001
NODE_ENV=development

# Database PostgreSQL (Supabase)
# Ganti [YOUR-PASSWORD] dan [YOUR-PROJECT-ID] dengan nilai dari Supabase dashboard
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# JWT Secret Key
# Ganti dengan string acak yang panjang (minimal 32 karakter)
# Bisa generate di: https://generate-secret.vercel.app/32
JWT_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter
JWT_EXPIRES_IN=7d

# CORS - Izinkan akses dari frontend
FRONTEND_URL=http://localhost:3000
